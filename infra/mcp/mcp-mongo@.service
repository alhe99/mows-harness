[Unit]
# One shared MongoDB MCP server per database, over HTTP on 127.0.0.1, instead of a stdio copy per Claude session: 26 copies held
# ~3 GB of RAM and 1 GB of swap on 2026-10-29, and each carried its connection string, password included, on its command line
# where every local user could read it (/proc/<pid>/cmdline). Here the string sits in a root-only env file (systemd reads it before
# it drops to the unit's throwaway user) and every request must carry the x-mcp-token header that file names, since any local
# user can reach the port.
#
# %i = the env file's name: /etc/mows-mcp/%i.env (root:root 0600) holds MDB_MCP_CONNECTION_STRING, MDB_MCP_TRANSPORT=http,
# MDB_MCP_HTTP_HOST=127.0.0.1, MDB_MCP_HTTP_PORT, MDB_MCP_HTTP_HEADERS='{"x-mcp-token":"<token>"}',
# MDB_MCP_IDLE_TIMEOUT_MS=604800000 (a week: an idle session keeps its MCP session) and, for production, MDB_MCP_READ_ONLY=true.
# Sessions reach it as {"type":"http","url":"http://127.0.0.1:<port>/mcp","headers":{"x-mcp-token":"<token>"}} in mcp-interactive.json.
# Install: sudo cp infra/mcp/mcp-mongo@.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now mcp-mongo@<name>
Description=MongoDB MCP server (shared, HTTP) — %i
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=mcp-mongo/%i
Environment=HOME=%S/mcp-mongo/%i
EnvironmentFile=/etc/mows-mcp/%i.env
ExecStart=/usr/bin/mongodb-mcp-server
Restart=on-failure
RestartSec=5
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
