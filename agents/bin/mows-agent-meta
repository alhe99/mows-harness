#!/usr/bin/env python3
"""mows-agent-meta — the only validator an agent file gets.

Claude Code type-checks NOTHING in file-based agent frontmatter (verified 2.1.273:
maxTurns: "abc" and memory: nonsense both load silently), so both namespaces are checked here.

  mows-agent-meta json <agent.md>   frontmatter as JSON on stdout (exit 2 if none)
  mows-agent-meta lint <agent.md>   ERROR:/WARN: lines on stdout; exit 1 iff any ERROR

A KIT-MANAGED agent has a top-level `kit:` block (mowa-kit's stage manifest) and no `mows:` block.
Its host keys live in `kit.host.mowa`. Both subcommands present it in the mows shape every other
reader here expects (json adds "kit_managed": true), so render, list, prune, chat and the dashboard
need no second code path; lint additionally runs `kit lint` (KIT_BIN, else kit on PATH).

Env: MOWS_PROFILES_JSON = {"default":"<HOME>/.claude","work":"<HOME>/.claude-work"}
"""
import json
import os
import re
import shutil
import subprocess
import sys

try:
    import yaml
except ImportError:  # python3-yaml is a cloud-init dependency on Ubuntu server; absent on minimal images
    print("mows-agent-meta: python3 yaml module missing: sudo apt-get install -y python3-yaml", file=sys.stderr)
    sys.exit(2)

# The CLI's --permission-mode choices (2.1.x). "default" is gone: an agent file still saying it is ignored and the
# session falls to auto, whose classifier decides each write by judgement (it denied gh pr review 6 times in 25 turns).
PERM = {"manual", "auto", "acceptEdits", "plan", "dontAsk", "bypassPermissions"}
MEM = {"user", "project", "local"}
ISO = {"worktree", "none"}
MODEL_ALIAS = {"sonnet", "opus", "haiku", "inherit"}
MOWS_KEYS = {"profile", "workdir", "task", "budget", "triggers", "merge", "escalate", "retention_days", "soul", "allow", "deny"}
BUDGET_KEYS = {"usd_per_run", "max_turns", "usd_per_day", "quota_floor", "chat_usd", "chat_turns"}
SOUL_MAX_BYTES = 16384  # a soul is a role, not a manual (spec 2026-09-20 D3)
TRIGGER_TYPES = {"cron", "path", "webhook"}
# The agent name is simultaneously a systemd instance name, a unit filename, a config key
# (WEBHOOK_SECRET_<NAME>) and a URL path segment (/agents/<name>, /wh/<name>). This is the
# intersection that keeps all four safe, and it must mirror lite.mjs's AGENT_RE exactly — a
# future edit to either pattern should update the other (infra/dashboard/lite.mjs, AGENT_RE).
AGENT_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
# Tool names that confer write capability even when Write/Edit are both in disallowedTools:
# a shell can always write via redirection (`echo x > f`), and Task can spawn a subagent that
# has its own tools regardless of the parent's disallowedTools. See can_write below.
WRITE_CAPABLE_TOOLS = {"Bash", "Task"}


def frontmatter(path):
    text = open(path, encoding="utf-8").read()
    m = re.match(r"^---[ \t]*\n(.*?)\n---[ \t]*(\n|$)", text, re.S)
    if not m:
        return None
    try:
        data = yaml.safe_load(m.group(1))
    except yaml.YAMLError as e:
        return {"__yaml_error__": str(e).splitlines()[0]}
    return data if isinstance(data, dict) else None


KIT_HOST = "mowa"  # the overlay this host reads: kit.host.mowa


def is_kit_managed(fm):
    return isinstance(fm, dict) and isinstance(fm.get("kit"), dict) and "mows" not in fm


def from_kit(fm, path):
    """A kit-managed agent seen through the mows shape. kit.host.mowa carries the host keys
    (profile, triggers, escalate, retention_days, budget.quota_floor/chat_*); workdir and task
    there override kit's for this host, exactly as `kit run` applies them with KIT_HOST=mowa.
    A relative workdir resolves against the manifest's git toplevel, as the kit resolves it."""
    if not is_kit_managed(fm):
        return fm
    kit = fm["kit"]
    hosts = kit.get("host") if isinstance(kit.get("host"), dict) else {}
    host = hosts.get(KIT_HOST) if isinstance(hosts.get(KIT_HOST), dict) else {}
    kb = kit.get("budget") if isinstance(kit.get("budget"), dict) else {}
    hb = host.get("budget") if isinstance(host.get("budget"), dict) else {}
    budget = {k: v for k, v in kb.items() if k in ("usd_per_run", "max_turns", "usd_per_day")}
    budget.update({k: v for k, v in hb.items() if k in ("quota_floor", "chat_usd", "chat_turns")})
    here = os.path.dirname(os.path.abspath(path))
    wd = host.get("workdir", kit.get("workdir"))
    if isinstance(wd, str) and not os.path.isabs(os.path.expanduser(wd)):
        top = subprocess.run(["git", "-C", here, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        wd = os.path.normpath(os.path.join(top.stdout.strip() if top.returncode == 0 else here, wd))
    m = {"profile": host.get("profile"), "workdir": wd, "task": host.get("task", kit.get("task")),
         "budget": budget, "triggers": host.get("triggers", []),
         "escalate": host.get("escalate", {"via": "none"}), "retention_days": host.get("retention_days", 30)}
    if isinstance(kit.get("soul"), str) and kit["soul"]:
        sp = os.path.expanduser(kit["soul"])
        m["soul"] = sp if os.path.isabs(sp) else os.path.join(here, sp)
    if isinstance(kit.get("merge"), dict):
        m["merge"] = kit["merge"]
    out = dict(fm)
    out["mows"] = m
    out["kit_managed"] = True
    return out


def kit_lint(path):
    """`kit lint` on a kit-managed file: its ERROR/WARN lines, prefixed `kit:`. Fails closed."""
    kit = os.environ.get("KIT_BIN") or shutil.which("kit")
    if not kit or not shutil.which(kit):
        return ["kit-managed agent (top-level kit: block) but the kit CLI is not installed "
                "(set KIT_BIN or put kit on PATH)"], []
    r = subprocess.run([kit, "lint", path], capture_output=True, text=True)
    E = ["kit: " + l[7:] for l in r.stdout.splitlines() if l.startswith("ERROR: ")]
    W = ["kit: " + l[6:] for l in r.stdout.splitlines() if l.startswith("WARN: ")]
    if r.returncode not in (0, 1) or (r.returncode == 1 and not E):
        E.append(f"kit lint did not run cleanly (exit {r.returncode}): {(r.stdout + r.stderr).strip()[:200]}")
    return E, W


def as_list(v):
    """Claude accepts `tools: Read, Grep` (string) and `tools: [Read, Grep]` (list).

    BOTH BRANCHES STRIP, and a list carrying a non-string is not a tool list. This used to be
    `list(v) if isinstance(v, list) else None`, which was wrong twice over (Task 9 fix round 1):

      - `tools: ["Read", "Bash "]` kept the trailing space, so `WRITE_CAPABLE_TOOLS & set(tools)`
        below missed it and a write-capable agent linted clean. The string form of the SAME
        declaration stripped and was flagged. One trailing space and the answer flipped, in the
        permissive direction.
      - `- Bash:` instead of `- Bash` is an ordinary typo; YAML parses it as {"Bash": None}, and
        the `set(tools)` on the can_write line below then raised an unhandled
        `TypeError: unhashable type: 'dict'`. The operator got a Python traceback from the one
        tool whose whole job is explaining what is wrong with their file. It failed CLOSED
        (mows-agent:210 refuses the run on a non-zero lint), so this is robustness rather than
        safety -- but a traceback is not a lint message.

    Returning None routes both into the existing "tools must be a list or comma-separated string"
    error, which is what an unreadable value should have produced all along.

    Kept deliberately identical to asList() in infra/dashboard/capability.mjs, so the validator and
    the dashboard cannot disagree about what a tools: field says. They are separate programs in
    separate languages and neither can import the other, so the agreement is asserted instead:
    scripts/e2e-agents.sh drives THIS function and scripts/capability-check.mjs drives that one,
    over the same table of inputs.
    """
    if v is None:
        return []
    if isinstance(v, str):
        return [t.strip() for t in v.split(",") if t.strip()]
    if isinstance(v, list):
        if not all(isinstance(t, str) for t in v):
            return None
        return [t.strip() for t in v if t.strip()]
    return None


def is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def is_num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def lint(path):
    E, W = [], []
    fm = frontmatter(path)
    if fm is None:
        return ["no YAML frontmatter (file must start with ---)"], []
    if "__yaml_error__" in fm:
        return ["frontmatter is not valid YAML: " + fm["__yaml_error__"]], []
    stem = os.path.splitext(os.path.basename(path))[0]
    if isinstance(fm.get("kit"), dict) and "mows" in fm:
        E.append("both a mows: and a kit: block: the runner would read mows: and silently ignore kit:; keep one")
    kit_managed = is_kit_managed(fm)
    if kit_managed:
        KE, KW = kit_lint(path)
        E += KE
        W += KW
        hosts = fm["kit"].get("host")
        if not (isinstance(hosts, dict) and isinstance(hosts.get(KIT_HOST), dict)):
            E.append(f"kit.host.{KIT_HOST}: block is required for this harness to run a kit-managed agent "
                     "(profile, triggers, escalate live there)")
        fm = from_kit(fm, path)

    # ---- Claude Code namespace ----
    if fm.get("name") != stem:
        E.append(f"name must equal the filename stem '{stem}' (got {fm.get('name')!r})")
    if not AGENT_NAME_RE.match(stem):
        E.append(f"name '{stem}' must match {AGENT_NAME_RE.pattern} (mirrors lite.mjs's AGENT_RE — "
                 "the name doubles as a systemd unit name, a config key, and a URL path segment)")
    if not isinstance(fm.get("description"), str) or not fm["description"].strip():
        E.append("description is required")
    if "maxTurns" in fm and not (is_int(fm["maxTurns"]) and fm["maxTurns"] > 0):
        E.append(f"maxTurns must be a positive integer (got {fm['maxTurns']!r})")
    if "memory" in fm and fm["memory"] not in MEM:
        E.append(f"memory must be one of {sorted(MEM)} (got {fm['memory']!r})")
    if fm.get("permissionMode") == "bypassPermissions":
        E.append("permissionMode: bypassPermissions is forbidden for agents (spec §7)")
    elif fm.get("permissionMode") == "default":
        E.append("permissionMode: default is no longer a CLI mode and is ignored (the session falls to auto); "
                 "use dontAsk for a fixed allowlist, auto for classifier review, or manual")
    elif "permissionMode" in fm and fm["permissionMode"] not in PERM:
        E.append(f"permissionMode must be one of {sorted(PERM)} (got {fm['permissionMode']!r})")
    if "isolation" in fm and fm["isolation"] not in ISO:
        E.append(f"isolation must be one of {sorted(ISO)} (got {fm['isolation']!r})")
    model = fm.get("model")
    if model is not None and not (model in MODEL_ALIAS or (isinstance(model, str) and model.startswith("claude-"))):
        E.append(f"model must be sonnet|opus|haiku|inherit or a claude-* id (got {model!r})")
    tools = as_list(fm.get("tools"))
    dis = as_list(fm.get("disallowedTools"))
    if tools is None:
        E.append("tools must be a list or comma-separated string")
    if dis is None:
        E.append("disallowedTools must be a list or comma-separated string")
    # A Bash(...) pattern in frontmatter disallowedTools removes the WHOLE Bash tool from the agent (verified
    # 2026-10-30: the reviewer came up with Read/Glob/Grep only). Command-level denies belong in mows.deny.
    for t in dis or []:
        if isinstance(t, str) and t.startswith("Bash("):
            E.append(f"disallowedTools: {t!r} removes Bash entirely; put command patterns in mows.deny")
    # "Read-only" from disallowedTools alone is a lie if the agent also has Bash or Task:
    # a shell writes fine through redirection, and Task can hand a subagent its own tools —
    # neither is stopped by disallowing Write/Edit on the parent (SETUP.md's safety posture).
    #
    # AN ABSENT `tools:` KEY INHERITS EVERYTHING, INCLUDING Bash (Task 9 fix round 2, review F4).
    # `as_list(None)` returns [] for an absent key and for `tools: null` alike, so `set(tools or [])`
    # was empty and this line reported precisely the lie the comment above warns about:
    #
    #   no tools: key, disallowedTools: [Write, Edit]   -> can_write False -> "read-only"
    #   tools: [Bash],  disallowedTools: [Write, Edit]  -> can_write True
    #
    # Two agents with identical capability, opposite verdicts, and the flattering one goes to the
    # agent whose file says the least. It suppressed the webhook warning below — an untrusted
    # external trigger on an agent that can run shell commands, which is the single combination that
    # warning exists to catch — and it wrongly errored on `merge.policy: pr` (that one fails closed).
    # infra/dashboard/capability.mjs has always read an absent key as `inherits`; this is the same
    # ruling, one layer down, in the program that decides whether the file is ACCEPTED.
    #
    # An UNREADABLE tools: value (as_list -> None) inherits here too. It is already a lint error two
    # lines above, so this only decides what the warnings say about a file that is being rejected —
    # and saying "it may hold every tool" about a file nobody could parse is the same direction
    # capability.mjs rounds in, for the same reason.
    inherits_tools = fm.get("tools") is None or tools is None
    can_write = (not ({"Write", "Edit"} <= set(dis or []))
                 or inherits_tools
                 or bool(WRITE_CAPABLE_TOOLS & set(tools or [])))

    # ---- mows namespace ----
    mows = fm.get("mows")
    if not isinstance(mows, dict):
        E.append("mows: block is required")
        return E, W
    for k in sorted(set(mows) - MOWS_KEYS):
        E.append(f"mows.{k}: unknown key (allowed: {sorted(MOWS_KEYS)})")
    for k in ("allow", "deny"):
        v = mows.get(k)
        if v is not None and not (isinstance(v, list) and all(isinstance(x, str) and x and "," not in x for x in v)):
            E.append(f"mows.{k} must be a list of permission rules without commas, e.g. \"Bash(gh pr review:*)\"")
    profiles = json.loads(os.environ.get("MOWS_PROFILES_JSON") or "{}")
    prof = mows.get("profile")
    if not prof:
        E.append("mows.profile is required")
    elif prof not in profiles:
        E.append(f"mows.profile '{prof}' is not a known profile (known: {sorted(profiles)})")
    wd = mows.get("workdir")
    if not isinstance(wd, str) or not wd:
        E.append("mows.workdir is required")
    elif not os.path.isdir(os.path.expanduser(wd)):
        E.append(f"mows.workdir does not exist: {wd}")
    # A soul (spec 2026-09-20 D1/D3): a shared role file appended to every run and chat turn. It
    # is optional; when named it must exist, be a regular file, be non-empty and stay under
    # SOUL_MAX_BYTES — a missing one must fail here rather than produce an agent that quietly does
    # not know what it is.
    soul = mows.get("soul")
    if soul is not None:
        if not isinstance(soul, str) or not soul.strip():
            E.append("mows.soul must be a non-empty path string")
        else:
            sp = os.path.expanduser(soul)
            if not os.path.exists(sp):
                E.append(f"mows.soul does not exist: {soul}")
            elif not os.path.isfile(sp):
                E.append(f"mows.soul must be a regular file: {soul}")
            elif os.path.getsize(sp) == 0:
                E.append(f"mows.soul is empty: {soul}")
            elif os.path.getsize(sp) > SOUL_MAX_BYTES:
                E.append(f"mows.soul is {os.path.getsize(sp)} bytes; the limit is {SOUL_MAX_BYTES}")
    if not isinstance(mows.get("task"), str) or not mows["task"].strip():
        E.append("mows.task is required (the default prompt of a run)")
    b = mows.get("budget")
    if not isinstance(b, dict):
        E.append("mows.budget is required")
    else:
        for k in sorted(set(b) - BUDGET_KEYS):
            E.append(f"mows.budget.{k}: unknown key (allowed: {sorted(BUDGET_KEYS)})")
        if not (is_num(b.get("usd_per_run")) and b["usd_per_run"] > 0):
            E.append("mows.budget.usd_per_run must be a number > 0")
        if not (is_int(b.get("max_turns")) and b["max_turns"] > 0):
            E.append("mows.budget.max_turns must be a positive integer")
        # An agent file carries TWO turn limits: `maxTurns` in the Claude namespace, which the CLI
        # reads out of this file, and mows.budget.max_turns, which mows-agent passes as --max-turns.
        # Until now this validator range-checked each and compared them never, so `maxTurns: 100`
        # beside `max_turns: 5` passed clean and the contradiction surfaced only on the dashboard's
        # capability panel -- which means an agent nobody opens in the dashboard keeps it forever.
        # Measured on this box: the flag wins (a run with maxTurns: 2 and --max-turns 20 took four
        # turns), so the Claude-namespace figure is the one that silently does nothing, and an
        # operator who wrote it believes in a cap they do not have.
        if is_int(fm.get("maxTurns")) and is_int(b.get("max_turns")) and fm["maxTurns"] != b["max_turns"]:
            E.append(f"maxTurns ({fm['maxTurns']}) and mows.budget.max_turns ({b['max_turns']}) "
                     "disagree; mows-agent passes the mows figure as --max-turns and it is the one "
                     "that binds, so the maxTurns value would silently do nothing. Make them equal "
                     "or drop maxTurns.")
        if "usd_per_day" in b and not (is_num(b["usd_per_day"]) and b["usd_per_day"] > 0):
            E.append("mows.budget.usd_per_day must be a number > 0")
        if "quota_floor" in b and not (is_int(b["quota_floor"]) and 0 <= b["quota_floor"] <= 100):
            E.append("mows.budget.quota_floor must be an integer 0..100")
        # Per-agent chat caps (spec 2026-09-20 D7); absent means the runner's global defaults.
        if "chat_usd" in b and not (is_num(b["chat_usd"]) and 0 < b["chat_usd"] <= 10):
            E.append("mows.budget.chat_usd must be a number in (0, 10]")
        if "chat_turns" in b and not (is_int(b["chat_turns"]) and 1 <= b["chat_turns"] <= 40):
            E.append("mows.budget.chat_turns must be an integer 1..40")
    trig = mows.get("triggers", [])
    has_webhook = False
    if not isinstance(trig, list):
        E.append("mows.triggers must be a list")
    else:
        for i, t in enumerate(trig):
            if not isinstance(t, dict) or t.get("type") not in TRIGGER_TYPES:
                E.append(f"mows.triggers[{i}].type must be one of {sorted(TRIGGER_TYPES)}")
                continue
            if t["type"] == "cron":
                spec = t.get("spec")
                if not isinstance(spec, str) or not spec:
                    E.append(f"mows.triggers[{i}].spec is required for cron")
                elif shutil.which("systemd-analyze"):
                    r = subprocess.run(["systemd-analyze", "calendar", spec], capture_output=True, text=True)
                    if r.returncode != 0:
                        E.append(f"mows.triggers[{i}].spec is not valid OnCalendar syntax: {spec!r}")
                else:
                    W.append(f"mows.triggers[{i}]: systemd-analyze not found, cron spec unchecked")
            elif t["type"] == "path":
                pth = t.get("path")
                if not isinstance(pth, str) or not os.path.isabs(os.path.expanduser(pth)):
                    E.append(f"mows.triggers[{i}].path must be an absolute path (~ allowed)")
            else:
                has_webhook = True
                if set(t) - {"type"}:
                    E.append(f"mows.triggers[{i}]: webhook takes no keys besides type (the secret lives in config)")
    # a kit-managed agent's merge is the kit's (none|branch|pr, run by `kit run`); kit lint checked it
    mg = {} if kit_managed else mows.get("merge", {})
    if not isinstance(mg, dict):
        E.append("merge: must be a map")
    else:
        pol = mg.get("policy", "none")
        if pol not in {"none", "pr"}:
            E.append(f"merge.policy must be none|pr (got {pol!r})")
        if pol == "pr":
            if not shutil.which("gh"):
                E.append("merge.policy: pr requires gh on PATH")
            elif subprocess.run(["gh", "auth", "status"], capture_output=True).returncode != 0:
                E.append("merge.policy: pr requires `gh auth status` to pass for this user")
            if not can_write:
                E.append("merge.policy: pr but Write and Edit are both disallowed: nothing to merge")
        if "base" in mg and not isinstance(mg["base"], str):
            E.append("merge.base must be a string")
    esc = mows.get("escalate", {})
    if not isinstance(esc, dict) or esc.get("via", "none") not in {"discord", "none"}:
        E.append("mows.escalate.via must be discord|none")
    rd = mows.get("retention_days", 30)
    if not (is_int(rd) and rd > 0):
        E.append("mows.retention_days must be a positive integer")
    if has_webhook and can_write:
        W.append("webhook trigger + write tools on one agent (untrusted trigger with write capability): "
                 "add Write, Edit to disallowedTools unless you mean it")
    return E, W


def main():
    if len(sys.argv) != 3 or sys.argv[1] not in {"json", "lint"}:
        print(__doc__)
        sys.exit(64)
    cmd, path = sys.argv[1], sys.argv[2]
    if not os.path.isfile(path):
        print(f"mows-agent-meta: no such file {path}", file=sys.stderr)
        sys.exit(2)
    if cmd == "json":
        fm = frontmatter(path)
        if fm is None or "__yaml_error__" in fm:
            print(f"mows-agent-meta: no usable frontmatter in {path}", file=sys.stderr)
            sys.exit(2)
        json.dump(from_kit(fm, path), sys.stdout, default=str)
        print()
        return
    errors, warns = lint(path)
    for w in warns:
        print("WARN: " + w)
    for e in errors:
        print("ERROR: " + e)
    sys.exit(1 if errors else 0)


if __name__ == "__main__":
    main()
