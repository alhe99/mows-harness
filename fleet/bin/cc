#!/usr/bin/env bash
# cc — launch Claude Code for a profile in a named tmux session.
# usage: cc [profile] [dir] [-- <claude flags...>]   (bare `cc` = default profile, cwd)
# caveat: profile names containing '-' can alias with directory slugs in session names.
#
# tmux session name: cc-<profile>-<slug-of-dir-basename>, plus a -2, -3 … suffix for a
# second, deliberate session in a directory that already has one (see the prompt below).
# watchdogs/bin/reap-idle-claude reaps sessions matching ^cc- when detached+idle; the
# naming here is the contract it depends on — do not change the cc-<profile>-<slug> shape.
#
# Delta vs. live ~/.local/bin/cc + ~/.local/bin/ccw (full reconciliation in
# .superpowers/sdd/task-7-report.md): live is two fixed-profile scripts (one per
# account), each always operating in $PWD with no [profile]/[dir] args, and each
# branches on $1 to either wrap bare/-c/--continue/-r/--resume invocations in tmux or
# `exec` claude directly for one-off args (e.g. --print). This unifies both into one
# profile-parameterized launcher per the Task 7 interface (`cc [profile] [dir]`), now
# with pass-through claude flags restored via a trailing `--` and the live
# TTY/nested-tmux guard restored verbatim — the original "flags no longer forwarded"
# trade-off no longer applies. Two live tmux details DO matter and are ported verbatim:
# `-D` (detach any other attached client before attaching — a dropped SSH connection
# must never block a clean reattach) added alongside `-A`, and the printf '%q'
# env-passing style for safe shell-quoting of the inner command (stronger than plain
# interpolation once profile-specific paths vary).
set -euo pipefail

profiles() {            # prints: default + every suffix of ~/.claude-<suffix>
  echo default
  for d in "$HOME"/.claude-*; do [ -d "$d" ] && basename "$d" | sed 's/^\.claude-//'; done
}
cfg_for() { [ "$1" = default ] && echo "$HOME/.claude" || echo "$HOME/.claude-$1"; }

# -h/--help before anything else: without this the word "--help" falls through to the
# positional [dir] slot and becomes a directory name. Claude's own --help is still
# reachable as `cc -- --help`, which forwards it like any other claude flag.
case "${1-}" in
  -h|--help)
    cat <<'EOF'
usage: cc [profile] [dir] [-- <claude flags...>]

  cc                       default profile (~/.claude), current directory
  cc <profile>             ~/.claude-<profile>, current directory
  cc <profile> <dir>       ~/.claude-<profile>, in <dir>
  cc <dir>                 default profile, in <dir>
  cc [profile] [dir] -w <name>   session in its own git worktree/branch (see ccwt)
  cc <profile> -- --continue   pass flags through to claude itself

Runs claude inside tmux session cc-<profile>-<slug> when attached to a terminal,
so a dropped connection never kills the session; execs claude directly otherwise.
If that directory already has a live session, asks whether to work in it or start
a second one alongside it (cc-<profile>-<slug>-2, -3 …).

profiles on this box:
EOF
    profiles | sed 's/^/  /'
    exit 0 ;;
esac

P=default
[ $# -ge 1 ] && case " $(profiles | tr '\n' ' ') " in *" $1 "*) P=$1; shift ;; esac
# -w <name> is accepted before or after [dir]: run the session in its own git
# worktree (branch worktree-<name>, checkout at <dir>/.claude/worktrees/<name>)
# so parallel sessions in one repo never share a tree. cc creates the worktree
# itself — native `claude --worktree` trips a legacy trust check
# (hasTrustDialogAccepted) the modern trust flow never satisfies — and reuses
# it when it already exists, so re-running the same -w reattaches/resumes.
# Merge back: ccwt done.
WT=""
mkwt() { # create/reuse the -w worktree at $WTP; branch may survive a removed checkout
  WT="${WT//[^a-zA-Z0-9._-]/-}"
  WTP="$DIR/.claude/worktrees/$WT"
  [ -d "$WTP" ] && return 0
  git -C "$DIR" worktree add -b "worktree-$WT" "$WTP" >/dev/null 2>&1 \
    || git -C "$DIR" worktree add "$WTP" "worktree-$WT" >/dev/null \
    || { echo "cc: could not create worktree $WTP (not a git repo?)" >&2; exit 1; }
}
if [ "${1-}" = "-w" ]; then WT="${2-}"; [ -n "$WT" ] || { echo "cc: -w needs a name" >&2; exit 1; }; shift 2; fi
DIR=$PWD; if [ $# -ge 1 ] && [ "$1" != "--" ] && [ "$1" != "-w" ]; then DIR=$1; shift; fi
if [ "${1-}" = "-w" ]; then WT="${2-}"; [ -n "$WT" ] || { echo "cc: -w needs a name" >&2; exit 1; }; shift 2; fi
[ "${1-}" = "--" ] && shift
CFG=$(cfg_for "$P")
[ -d "$CFG" ] || { echo "cc: no profile dir $CFG (create it or run: cc)" >&2; exit 1; }

RUN=(claude)
[ -f "$CFG/mcp-interactive.json" ] && RUN+=(--strict-mcp-config --mcp-config "$CFG/mcp-interactive.json")
RUN+=("$@")

if [ -z "${TMUX:-}" ] && [ -t 0 ]; then
  SLUG=$(basename "$DIR" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-' | sed 's/^-*//;s/-*$//')
  SES="cc-$P-$SLUG"
  # A live session in this directory used to be joined silently — `-AD` attaches whenever
  # the name already exists — so "start a session here" and "get back into the session
  # here" were one indistinguishable action, and a SECOND parallel session in the same
  # directory was simply unreachable: you always got the first one back. Ask instead.
  # A new one takes the next free -2, -3 … suffix, still under the cc- prefix
  # watchdogs/bin/reap-idle-claude matches (^cc-), so extra sessions are reaped like any
  # other. Only asked when there is a terminal to answer with: the `-t 0` guard above
  # already gates this branch, so scripted and nested-tmux callers keep the old path.
  # ANY session working in this directory counts — webconsole (web-*) and other
  # profiles' launchers included, not just our own cc-<profile>-<slug> name.
  # Compared on pane_current_path against the normalized [dir].
  DIRABS=$(cd "$DIR" 2>/dev/null && pwd || echo "$DIR")
  # @label last in the format — a user-set label may itself contain tabs
  HERE="$(tmux list-sessions -F $'#{session_name}\t#{pane_current_path}\t#{@label}' 2>/dev/null \
    | awk -F'\t' -v p="$DIRABS" '$2==p {print $1 "\t" $3}')"
  if [ -z "$WT" ] && [ -n "$HERE" ]; then
    TGT="$(printf '%s\n' "$HERE" | cut -f1 | grep -m1 "^cc-$P-" || true)"
    [ -n "$TGT" ] || TGT="$(printf '%s\n' "$HERE" | head -1 | cut -f1)"
    printf 'cc: Claude session(s) already running in %s:\n' "$DIRABS"
    printf '%s\n' "$HERE" | awk -F'\t' '{print "    " $1 ($2==""?"":" · " $2)}'
    printf '  [Enter] work in %s   [n] new session, same tree   [w] new worktree, own branch   [q] quit\n' "$TGT"
    read -rp '  > ' ANS || ANS=q
    case "$ANS" in
      n|N|new) if tmux has-session -t "=$SES" 2>/dev/null; then
                 N=2
                 while tmux has-session -t "=$SES-$N" 2>/dev/null; do N=$((N+1)); done
                 SES="$SES-$N"
               fi
               printf 'cc: starting %s\n' "$SES" ;;
      w|W) read -rp '  worktree name > ' WT
           [ -n "$WT" ] || exit 1 ;;
      q|Q) exit 0 ;;
      *) exec tmux attach -d -t "=$TGT" ;;
    esac
  fi
  if [ -n "$WT" ]; then
    # Session name gets a -wt-<slug> suffix (still ^cc-, so the reaper matches)
    # and is pre-labeled via @label for dashboard rows / tab titles / Discord.
    mkwt
    WSLUG=$(printf '%s' "$WT" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-' | sed 's/^-*//;s/-*$//')
    SES="$SES-wt-$WSLUG"
    if ! tmux has-session -t "=$SES" 2>/dev/null; then
      tmux new-session -d -s "$SES" -c "$WTP" \
        "$(printf '%q ' env CLAUDE_CONFIG_DIR="$CFG" "${RUN[@]}")"
      tmux set-option -t "=$SES:" @label "$WT" 2>/dev/null || true
    fi
    exec tmux attach -d -t "=$SES"
  fi
  exec tmux new-session -AD -s "$SES" -c "$DIR" \
    "$(printf '%q ' env CLAUDE_CONFIG_DIR="$CFG" "${RUN[@]}")"
elif env -C / true 2>/dev/null; then
  # direct-exec fallback (no tty, or already nested in tmux): chdir into [dir] before exec
  # — same effect as the tmux branch's own `-c "$DIR"` above. Used to silently ignore
  # [dir] here and run wherever `cc` itself was invoked from instead. `env -C` (GNU
  # coreutils >= 8.28) chdirs and execs in one call; probed with `/` (always chdir-able)
  # so this only tests whether -C itself is supported, not whether "$DIR" is valid — a bad
  # "$DIR" fails the same way either branch, via the plain `cd` in the fallback below.
  if [ -n "$WT" ]; then mkwt; DIR="$WTP"; fi
  exec env -C "$DIR" CLAUDE_CONFIG_DIR="$CFG" "${RUN[@]}"
else
  if [ -n "$WT" ]; then mkwt; DIR="$WTP"; fi
  cd "$DIR" && exec env CLAUDE_CONFIG_DIR="$CFG" "${RUN[@]}"
fi
