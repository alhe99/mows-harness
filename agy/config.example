# mows-agy config — sourced by agy-run.
# Installed to ~/.config/mows-agy/config (only if absent; your edits are kept).
# Populate model slugs from:  agy models
AGY_BIN=${AGY_BIN:-agy}   # defaulting form: an env override (tests, stubs) beats this file
AGY_FAST_MODEL=            # flash-tier slug for cheap sync tasks (empty = agy default)
# agy-notify (used by watchdogs, e.g. patch-health-check) posts here;
# silent no-op until set.
# Discord webhook URL (channel settings -> Integrations -> Webhooks).
# Grants post access to that channel: keep this file chmod 600.
AGY_DISCORD_WEBHOOK=
