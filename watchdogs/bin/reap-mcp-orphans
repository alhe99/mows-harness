#!/usr/bin/env bash
# Reap orphaned MCP servers: parent session died, child reparented to init (ppid=1).
# A LIVE MCP server always has its session process as parent, never pid 1 -> ppid==1 == orphan.
# Matches ppid==1 + 'mcp' + age>5min, excludes the remote-control daemons (no 'mcp' in their
# cmd). A daemonized tmux server KEEPS the argv of the client that spawned it — e.g.
# "tmux new-session ... claude --mcp-config ..." — so /mcp/ can match tmux servers hosting
# live claude sessions. Never match on cmdline substrings that can embed a user command:
# exclude tmux and claude explicitly.
set -euo pipefail

ST="$HOME/.local/state"
LOG="$ST/reap-mcp-orphans.log"
mkdir -p "$ST"
ts=$(date '+%F %T')

mapfile -t pids < <(ps -eo pid=,ppid=,etimes=,cmd= 2>/dev/null |
  awk '$2==1 && $3>300 && tolower($0) ~ /(^|[^a-z0-9])mcp([^a-z0-9]|$)/ && !/remote-control|tmux|claude/ {print $1}')

for pid in "${pids[@]}"; do
  [ -n "$pid" ] || continue
  cmd=$(ps -o cmd= -p "$pid" 2>/dev/null | cut -c1-80 || true)
  [ -z "$cmd" ] && continue
  if kill -TERM "$pid" 2>/dev/null; then
    echo "$ts TERM $pid $cmd" >> "$LOG"
  fi
  sleep 2
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid" 2>/dev/null || true
    echo "$ts KILL(straggler) $pid $cmd" >> "$LOG"
  fi
done

exit 0
